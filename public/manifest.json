{
  "manifest_version": 3,
  "name": "baize chrome tool",
  "version": "1.0.0",
  "description": "baize chrome tool",
  "icons": {
    "16": "icons/ic_16.png",
    "48": "icons/ic_48.png",
    "128": "icons/ic_128.png"
  },
  "action": {
    "default_popup": "main/popup.html",
    "default_icon": "icons/ic_16.png",
    "default_title": "baize chrome tool"
  },
  "background": {
    "service_worker": "main/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["contentScript/index.js"],
      "matches": ["*://*/*"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["*://*/*"],
  "permissions": ["storage", "webNavigation"]
}
