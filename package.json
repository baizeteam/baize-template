{
  "name": "baize-chrome-tool",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_TYPE=development esno start.ts",
    "build": "esno start.ts",
    "zip": "rimraf baize-chrome-tool.zip && esno zip.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:contentScript": "vite build --config vite.contentScript.config.ts",
    "build:release": "pnpm run build && pnpm run zip"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@babel/runtime": "^7.26.9",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "antd": "^5.24.1",
    "core-js": "^3.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.4.3",
  },
  "devDependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@swc/core": "^1.10.18",
    "@swc/helpers": "^0.5.15",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/webpack-env": "^1.18.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "cross-zip": "^4.0.1",
    "css-loader": "^7.1.2",
    "esno": "^4.8.0",
    "express": "^4.21.2",
    "less": "^4.2.2",
    "less-loader": "^12.2.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "rimraf": "^6.0.1",
    "ssestream": "^1.1.0",
    "style-loader": "^4.0.0",
