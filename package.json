{
  "name": "baize-chrome-tool",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_TYPE=development esno start.ts",
    "build": "esno start.ts",
    "zip": "rimraf baize-chrome-tool.zip && esno zip.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:contentScript": "vite build --config vite.contentScript.config.ts",
    "build:release": "pnpm run build && pnpm run zip"
  },
  "dependencies": {
    "element-plus": "^2.9.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "esno": "^4.8.0",
    "express": "^4.21.2",
    "rimraf": "^6.0.1",
    "ssestream": "^1.1.0",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^19.1.0",
    "unplugin-vue-components": "^28.4.0",
    "vite": "^6.1.1",
    "vue-tsc": "^2.2.0"
  }
}
