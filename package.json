{
  "name": "baize-template",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "cd client && npm run dev",
    "server": "cd server && cross-env JSON_ENV=fat START_ENV=dev CONFIG_ENV=test npm run server",
    "build": "pnpm run server-build && pnpm run client-build",
    "client-build": "cd client && pnpm run build",
    "server-build": "cd server && pnpm run build",
    "prod": "pnpm --dir server run start:prod",
    "start": "esno start.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky install",
    "clear": "cd server && rm -rf ./dist/build/*.map"
  },
  "dependencies": {
    "esno": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "chalk": "^5.4.1",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "inquirer": "^12.4.2",
    "lint-staged": "^15.4.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "client/**/*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "nest-winston@1.10.2>@nestjs/common": "12"
      }
    }
  }
}
